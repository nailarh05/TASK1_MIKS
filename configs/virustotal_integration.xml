<!-- Konfigurasi Integrasi VirusTotal di Wazuh Manager -->
<!-- Ditambahkan ke /var/ossec/etc/ossec.conf pada Wazuh Manager -->
<!-- Rule 550 & 554 = FIM (File Integrity Monitoring) alerts -->

<integration>
  <name>virustotal</name>
  <api_key>YOUR_VIRUSTOTAL_API_KEY</api_key>
  <rule_id>550,554</rule_id>
  <alert_format>json</alert_format>
</integration>
